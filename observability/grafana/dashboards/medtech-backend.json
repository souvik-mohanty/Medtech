{
  "title": "MedTech Backend",
  "uid": "medtech-backend",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["medtech"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "medtech-prometheus" },
      "targets": [
        { "expr": "process_uptime_seconds{job=\"medtech-backend\"}", "legendFormat": "uptime" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "JVM Heap Used",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "medtech-prometheus" },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{job=\"medtech-backend\", area=\"heap\"})", "legendFormat": "heap used" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Active DB Connections (HikariCP)",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "medtech-prometheus" },
      "targets": [
        { "expr": "hikaricp_connections_active{job=\"medtech-backend\"}", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle{job=\"medtech-backend\"}", "legendFormat": "idle" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP Requests / sec by Status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "medtech-prometheus" },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"medtech-backend\"}[1m])) by (status)", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU Usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "medtech-prometheus" },
      "targets": [
        { "expr": "system_cpu_usage{job=\"medtech-backend\"} * 100", "legendFormat": "system" },
        { "expr": "process_cpu_usage{job=\"medtech-backend\"} * 100", "legendFormat": "process" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "max": 100, "min": 0 },
        "overrides": []
      }
    }
  ]
}
